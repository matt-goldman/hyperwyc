<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Declares the trim/AOT contract and turns on the analysers that enforce it. The
         audience is .NET MAUI, where iOS release builds are AOT by default, so a
         reflection-dependent path has to fail this build rather than a consumer's. -->
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Hyperwyc</RootNamespace>
    <Description>Core of Hyperwyc, a service-worker-inspired HTTP handler for .NET. Contains the handler, sync orchestrator and storage interfaces, with no storage dependency. Install this only if you are supplying your own ISyncStore — most consumers want the Hyperwyc package instead.</Description>
    <PackageTags>http;offline;cache;sync;delegatinghandler;maui</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <!-- Replays are sent through the originating named client's pipeline, so the
         orchestrator needs IHttpClientFactory. See issue #37. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <!-- Already present transitively via Hosting.Abstractions; referenced directly because
         StoreHealth takes an optional ILogger and an implicit dependency is a trap. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>
</Project>
