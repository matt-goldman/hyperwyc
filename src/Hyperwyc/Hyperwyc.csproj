<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Declares the trim/AOT contract and turns on the analysers that enforce it. The
         audience is .NET MAUI, where iOS release builds are AOT by default, so a
         reflection-dependent path has to fail this build rather than a consumer's. -->
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Hyperwyc.Cabinet</RootNamespace>
    <Description>A service-worker-inspired HTTP handler for .NET — transparent offline caching, queuing and replay for HttpClient. Includes durable Cabinet-backed storage, so AddHyperwyc() works with no further configuration.</Description>
    <PackageTags>http;offline;cache;sync;delegatinghandler;maui;cabinet</PackageTags>
    <PackageId>Hyperwyc</PackageId>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cabinet" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hyperwyc.Core\Hyperwyc.Core.csproj" />
  </ItemGroup>

</Project>
