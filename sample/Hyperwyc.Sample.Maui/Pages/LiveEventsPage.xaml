<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Hyperwyc.Sample.Maui.ViewModels"
             x:DataType="vm:LiveEventsViewModel"
             x:Class="Hyperwyc.Sample.Maui.Pages.LiveEventsPage">
 <VerticalStackLayout HorizontalOptions="Fill"
                      Margin="10,50">
        <Label Text="Live Events Stream"
               FontSize="24"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               Margin="20"/>

        <Label Text="Notifications raised by Hyperwyc as it replays HTTP requests will be displayed here"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               Margin="20"/>

        <CollectionView ItemsSource="{Binding LiveEvents}"
                        SelectionMode="Single"
                        VerticalOptions="Fill">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 20"
                            Margin="20,10"
                            Padding="10">
                        <Grid HorizontalOptions="Fill"
                              VerticalOptions="Fill"
                              HeightRequest="100"
                              ColumnDefinitions="*,*,*"
                              RowDefinitions="3*,2*,2*"
                              x:DataType="vm:EventViewModel">
                            <Label Grid.ColumnSpan="3"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{Binding TitleColor}"
                                   Text="{Binding Title}"/>

                            <Label Grid.Row="1"
                                   Text="{Binding Method, StringFormat='{0}:'}"/>

                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding Url}"/>

                            <Label Grid.Row="2"
                                   Text="{Binding TimeSent}"/>

                            <Label Grid.Row="2"
                                   Grid.Column="2"
                                   Text="{Binding EventType}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
