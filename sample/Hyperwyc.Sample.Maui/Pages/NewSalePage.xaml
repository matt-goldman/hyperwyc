<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Hyperwyc.Sample.Maui.ViewModels"
             x:DataType="vm:NewSaleViewModel"
             x:Class="Hyperwyc.Sample.Maui.Pages.NewSalePage">
    <Grid VerticalOptions="Fill"
          HorizontalOptions="Fill">
        <VerticalStackLayout HorizontalOptions="Fill"
                             VerticalOptions="Fill"
                             Spacing="30">

            <Label Text="New Sale"
                   FontSize="24"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="20"/>

            <Label Text="Error: product missing"
                   FontSize="18"
                   TextColor="Red"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="20"
                   IsVisible="{Binding ProductMissing}"/>

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="*,*,*"
                  Margin="50"
                  IsVisible="{Binding HasProduct}">
                <Label FontAttributes="Bold"
                       FontFamily="OpenSansSemibold"
                       Text="Product" />
                <Label Grid.Column="1"
                       Text="{Binding Product.Name}" />

                <Label Grid.Row="1"
                       FontAttributes="Bold"
                       FontFamily="OpenSansSemibold"
                       Text="Quantity" />
                <Entry Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding QuantityToSell}"
                       TextChanged="InputView_OnTextChanged"
                       Keyboard="Numeric"/>

                <Button Grid.Row="2"
                        Grid.ColumnSpan="2"
                        IsEnabled="{Binding SaleEnabled}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Text="Record sale"
                        Command="{Binding RecordSaleCommand}"/>
            </Grid>

        </VerticalStackLayout>

        <ActivityIndicator VerticalOptions="Center"
                           HorizontalOptions="Center"
                           HeightRequest="20"
                           IsVisible="{Binding IsLoading}"
                           IsRunning="True" />
    </Grid>
</ContentPage>
