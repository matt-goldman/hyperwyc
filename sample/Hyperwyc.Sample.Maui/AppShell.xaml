<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Hyperwyc.Sample.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Hyperwyc.Sample.Maui.Pages"
    Title="Hyperwyc.Sample.Maui">

    <FlyoutItem Title="Catalogue">
        <ShellContent
            Title="Products"
            ContentTemplate="{DataTemplate pages:CataloguePage}"
            Route="Products" />

        <ShellContent
            Title="Sales"
            ContentTemplate="{DataTemplate pages:SalesPage}"
            Route="Sales" />
    </FlyoutItem>

    <FlyoutItem Title="Admin">
        <ShellContent Title="Live Events"
                      ContentTemplate="{DataTemplate pages:LiveEventsPage}"
                      Route="Live"/>

        <ShellContent Title="Diagnostics"
                      ContentTemplate="{DataTemplate pages:DiagnosticsPage}"
                      Route="Diag"/>
    </FlyoutItem>

    <MenuItem Text="Login"
              Clicked="LoginMenuItem_OnClicked"
              x:Name="LoginMenuItem"/>

</Shell>
